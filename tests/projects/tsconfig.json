{
  // The node:test harness for the pure modules under src/lib.
  //   rm -rf .tmp-test && npx tsc -p tests/projects/tsconfig.json && node --test "tests/projects/*.test.mjs"
  // (npm run test:projects). src/lib/<path>.ts compiles to .tmp-test/lib/<path>.js, which a test
  // imports as ../../.tmp-test/lib/<path>.js. tsc leaves `@/…` specifiers as written, so a module a
  // test pulls in imports other modules RELATIVELY; `paths` is here for the type checker only.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2023"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": "../../src",
    "outDir": "../../.tmp-test",
    "paths": {
      "@/*": ["../../src/*"]
    }
  },
  "include": ["../../src/lib/settings/**/*", "../../src/lib/notifications/**/*", "../../src/lib/data/**/*", "../../src/lib/manual/**/*", "../../src/lib/commerce/**/*", "../../src/lib/brief/**/*", "../../src/lib/wallet/**/*", "../../src/lib/market/**/*", "../../src/lib/video/**/*", "../../src/lib/ui/tab-keys.ts", "../../src/lib/create/save-footer.ts", "../../src/lib/create/history-delete.ts", "../../src/lib/create/history-list.ts", "../../src/lib/create/item-times.ts", "../../src/lib/network/products.ts", "../../src/lib/create/concept-network.ts", "../../src/lib/create/companions.ts", "../../src/lib/network/from-concept.ts", "../../src/lib/innovations/**/*", "../../src/lib/feed.ts", "../../src/lib/feed-image-manifest.ts", "../../src/lib/messages/types.ts", "../../src/lib/messages/normalize.ts", "../../src/lib/messages/rules.ts", "../../src/lib/messages/risk.ts", "../../src/lib/messages/links.ts", "../../src/lib/messages/people.ts", "../../src/lib/messages/migrate.ts", "../../src/lib/messages/demo-seed.ts", "../../src/lib/blog/types.ts", "../../src/lib/blog/dates.ts", "../../src/lib/blog/categories.ts", "../../src/lib/blog/reasons.ts", "../../src/lib/blog/doc.ts", "../../src/lib/blog/status.ts", "../../src/lib/blog/demo-review.ts", "../../src/lib/blog/article.ts", "../../src/lib/blog/list.ts", "../../src/lib/blog/date-range.ts", "../../src/lib/blog/slug.ts", "../../src/lib/blog/normalize.ts", "../../src/lib/blog/media.ts", "../../src/lib/blog/cover.ts", "../../src/lib/blog/consent.ts", "../../src/lib/blog/thumbnail.ts", "../../src/lib/blog/article-view.ts", "../../src/components/blog/editor/editor-logic.ts", "../../src/lib/people/**/*", "../../src/lib/support/problem-report.ts", "../../src/lib/support/page-context.ts", "../../src/lib/support/recent-errors.ts", "../../src/lib/blog/news.ts", "../../src/lib/blog/confirm-copy.ts", "../../src/lib/blog/tag-link.ts", "../../src/lib/account/**/*", "../../src/lib/create/credits.tsx", "../../src/lib/create/credit-pricing.ts", "